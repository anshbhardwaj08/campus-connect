PORT=5000

# MongoDB Atlas connection string (include the database name before the ?)
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/campus-connect?retryWrites=true&w=majority

# Redis connection string (Redis Cloud, or redis://localhost:6379 if running locally)
REDIS_URL=redis://default:<password>@<host>:<port>

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Gmail address + app password (not your normal password)
NODEMAILER_USER=
NODEMAILER_PASS=

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE=

OPENAI_API_KEY=

# Comma-separated list of allowed college email domains
COLLEGE_EMAIL_DOMAINS=pec.edu.in

CLIENT_URL=http://localhost:5173
ADMIN_URL=http://localhost:5174
