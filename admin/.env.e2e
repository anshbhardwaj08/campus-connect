# Environment for the end-to-end suite (client/tests/e2e), selected with
# `vite --mode e2e`. Same as client/.env.e2e: it points the admin app at the
# throwaway API the harness starts on 5055 — never at the development server
# on 5000, which talks to the real database.
#
# No secrets here: these are localhost ports. Committed on purpose.
VITE_API_URL=http://localhost:5055/api/v1
VITE_SOCKET_URL=http://localhost:5055
