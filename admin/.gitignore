# Logs. `/logs`, not `logs`: the bare name also matched the source folder
# src/pages/logs, so AuditLogs.jsx was never committed and the deploy build
# could not find it.
/logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
