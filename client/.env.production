# Build-time settings for the deployed student app (`vite build`).
#
# The API server serves this app itself (server/src/app.js), so the API and
# the socket are on the page's own origin: a relative API path, and no socket
# URL at all. That is what keeps the login cookie first-party without a
# custom domain.
#
# No secrets here. Committed on purpose.
VITE_API_URL=/api/v1
VITE_SOCKET_URL=
VITE_COLLEGE_EMAIL_DOMAINS=pec.edu.in
